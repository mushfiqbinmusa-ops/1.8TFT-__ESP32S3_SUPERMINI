// =============================================================================
//  secrets.h  --  DO NOT COMMIT.
//
//  Copy this file to secrets.h and fill it in:
//
//      cp secrets.h.example secrets.h
//
//  secrets.h is already in .gitignore, so your Wi-Fi password and device token
//  stay local. If you ever paste a real token into this file in a commit, treat
//  the token as burned and regenerate it in
//  Settings -> Security -> Device Tokens.
//
// =============================================================================

#ifndef PHOTOFRAME_SECRETS_H
#define PHOTOFRAME_SECRETS_H

// -----------------------------------------------------------------------------
//  WIFI
// -----------------------------------------------------------------------------
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

//  Leave empty to use DHCP. Set all four to pin a static address instead --
//  worth doing, because the server needs a stable Host to reach your frame's
//  /api/system-info endpoint.
#define USE_STATIC_IP   false
#define STATIC_IP       "192.168.1.50"
#define STATIC_NETMASK  "255.255.255.0"
#define STATIC_GATEWAY  "192.168.1.1"
#define STATIC_DNS      "1.1.1.1"

// -----------------------------------------------------------------------------
//  SERVER
//
//  Base URL of the esp32-photoframe-server instance. No trailing slash, and do
//  NOT include the /image path -- the firmware appends it.
//
//  The ESP32-S3 has no DNS client for .local names, so use the numeric IP.
// -----------------------------------------------------------------------------
#define SERVER_BASE_URL "http://192.168.1.100:9607"

// -----------------------------------------------------------------------------
//  DEVICE TOKEN
//
//  Settings -> Security -> Device Tokens -> Generate, with this device selected.
//
//  It MUST be a device token, not an admin login token. The server identifies
//  the device purely from the token's device_id claim; an admin token has none
//  and the request comes back 400.
// -----------------------------------------------------------------------------
#define DEVICE_TOKEN    "YOUR_DEVICE_TOKEN_HERE"

#endif  // PHOTOFRAME_SECRETS_H
